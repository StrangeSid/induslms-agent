# Copy to .env (never commit real values)
INDUSLMS_EMAIL=
INDUSLMS_PASS=
INDUSLMS_TENANT=
INDUSLMS_TOKEN_FILE=
# School Outlook/OneDrive (Microsoft Graph, device-code flow, no Azure app needed)
# Default: builtin Office then Thunderbird clients. Just run `python3 outlook.py login`.
INDUS_OUTLOOK_CLIENT_ID=
# Optional: INDUS_OUTLOOK_AUTHORITY=https://login.microsoftonline.com/organizations
# Optional: INDUS_USE_BUILTIN_CLIENT=0  # force custom app id only
